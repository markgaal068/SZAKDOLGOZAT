## Másold le .env.local néven, és töltsd ki a saját adataiddal.
## A .env.local sosem kerül git-be (lásd .gitignore).

# NextAuth munkamenet-titkosításhoz használt kulcs - generálj egy egyedit, pl.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# MongoDB Atlas kapcsolati string (Atlas -> Database -> Connect -> Drivers)
MONGODB_URI=
